<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain HTTP (cleartext) network calls by default since API 28. The backend is plain HTTP (no TLS
  certificate), so without this every API call from the packaged app would fail with a cleartext-traffic-blocked error,
  even though the exact same code works from a normal web browser.

  This allows cleartext ONLY for the one server address below, not for the whole app (android:usesCleartextTraffic="true"
  in the manifest would do that, but is far broader than necessary).

  SERVER_HOST is a placeholder on purpose: the APK steps in the Production Deployment Guide replace it (here and in
  src/environments/environment.apk.ts) with the real server address before building.

  If the backend ever gets a proper domain with HTTPS, remove this file's domain-config and point
  environment.apk.ts at https:// - nothing then needs a cleartext exception.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">SERVER_HOST</domain>
    </domain-config>
</network-security-config>
