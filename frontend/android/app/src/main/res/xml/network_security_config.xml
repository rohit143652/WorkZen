<?xml version="1.0" encoding="utf-8"?>
<!--
  Android blocks plain HTTP (cleartext) network calls by default since API 28 - the backend at
  43.204.237.48:8080 is plain HTTP (no TLS certificate), so without this, every API call from
  the packaged app would fail with a cleartext-traffic-blocked error, even though the exact same
  code works fine from a regular web browser.

  This allows cleartext ONLY for that one specific IP, rather than turning it on for the whole
  app (android:usesCleartextTraffic="true" in the manifest would do that, but is far broader
  than necessary and a worse security posture for no real benefit here).

  If the backend ever moves to a proper domain with HTTPS, this file should be removed and
  environment.prod.ts's apiUrl switched back to https:// - there would be nothing left needing
  a cleartext exception at that point.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">43.204.237.48</domain>
    </domain-config>
</network-security-config>
