# ============================================================
# Secrets / local environment - NEVER commit real credentials.
# .env.example is intentionally NOT ignored (see the negation below) - it
# must stay tracked since it documents required variables with placeholders.
# ============================================================
.env
.env.*
!.env.example
!.env.*.example

# Local-only Spring profile files, if you ever create one for secrets that
# shouldn't be committed (application-dev.yml/application-prod.yml ARE
# tracked on purpose - they contain no secrets, only non-sensitive config).
application-local.yml
application-local.yaml
application-local.properties

# ============================================================
# Backend (Maven / Java)
# ============================================================
backend/target/
backend/.mvn/wrapper/maven-wrapper.jar
*.class
*.log
*.jar
!.mvn/wrapper/maven-wrapper.jar

# ============================================================
# Frontend (Angular / Node)
# ============================================================
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/*.log
npm-debug.log*

# ============================================================
# IDE / OS
# ============================================================
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
