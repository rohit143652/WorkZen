# IMPORTANT: Spring Boot does NOT read a ".env" file by itself - writing values into a file named
# .env does nothing unless something loads it into the process's environment. Ways that work:
#   * Production (Linux)  : keep a copy OUTSIDE the project, e.g. /etc/karmichr/backend.env
#                           (chmod 600), and let systemd load it - see deploy/karmichr-backend.service.
#   * Docker              : docker run --env-file /etc/karmichr/backend.env ...   (no quotes around values)
#   * Local (Windows)     : set real environment variables - README section 5.
# Keep the populated copy out of the repository: NEVER commit real passwords or secrets.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/workforce_auth?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me

# --- JWT ---
# Generate your own with: openssl rand -base64 64
# (PowerShell alternative: [Convert]::ToBase64String((1..64 | ForEach-Object {Get-Random -Max 256}) -as [byte[]]))
# Replace this placeholder with your OWN generated value - never reuse this literal text as a
# real secret, and never commit whatever you generate to .env.example or anywhere else.
JWT_SECRET=replace_with_your_own_generated_base64_secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Cookies (refresh token) ---
# true = HTTPS only. Set false ONLY while the site is still on plain http:// (browsers drop a Secure cookie over http,
# so every page reload would log users out); move to HTTPS and set it back to true.
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict

# --- Server ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Performance tuning (optional - all have safe defaults if omitted, see application.yml) ---
# DB_POOL_MAX_SIZE=30
# DB_POOL_MIN_IDLE=10
# TOMCAT_MAX_THREADS=200
# TOMCAT_MIN_SPARE_THREADS=20
# TOMCAT_ACCEPT_COUNT=150

# --- Mail (employee onboarding invitation emails) ---
# MAIL_PASSWORD must be a Gmail App Password (Google Account -> Security -> 2-Step Verification
# -> App Passwords), NEVER your actual Gmail account password. Generate one specifically for
# this app. Never commit the real value anywhere - .env is gitignored for exactly this reason.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password
MAIL_FROM=your-email@gmail.com
FRONTEND_BASE_URL=http://localhost:4200

# --- Employee onboarding invitation security (optional - safe defaults shown) ---
# INVITATION_EXPIRY_HOURS=24
# ONBOARDING_CODE_EXPIRY_MINUTES=30
# MAX_ONBOARDING_CODE_ATTEMPTS=5

# --- Time zone: what "today" and "now" mean to the application ---
# Servers (AWS especially) run in UTC, which is 5h30m behind India - without this, "today" is still yesterday until
# 05:30 IST and late/early-exit minutes are computed against the wrong clock. Default: Asia/Kolkata.
# APP_TIMEZONE=Asia/Kolkata

# --- Safety net for migration V109 (it WIPES payroll/attendance/leave history - see README) ---
# The app refuses to start if it would run V109 over a database that already holds data. Leave this false.
# ALLOW_DESTRUCTIVE_RESET=false
