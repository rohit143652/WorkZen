# Copy this file to .env (or export these as real environment variables)
# and NEVER commit the populated .env file.

# --- Database ---
DB_URL=jdbc:mysql://localhost:3306/workforce_auth?useSSL=false&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=change_me

# --- JWT ---
# Generate your own with: openssl rand -base64 64
# (PowerShell alternative: [Convert]::ToBase64String((1..64 | ForEach-Object {Get-Random -Max 256}) -as [byte[]]))
# Replace this placeholder with your OWN generated value - never reuse this literal text as a
# real secret, and never commit whatever you generate to .env.example or anywhere else.
JWT_SECRET=replace_with_your_own_generated_base64_secret
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- Cookies (refresh token) ---
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict

# --- Server ---
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# --- Performance tuning (optional - all have safe defaults if omitted, see application.yml) ---
# DB_POOL_MAX_SIZE=30
# DB_POOL_MIN_IDLE=10
# TOMCAT_MAX_THREADS=200
# TOMCAT_MIN_SPARE_THREADS=20
# TOMCAT_ACCEPT_COUNT=150
