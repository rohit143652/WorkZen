# systemd unit for the WORKZEN backend on a Linux server.
#
# Why this exists: environment variables typed into a terminal (export / $env:) disappear when
# that terminal closes. Here they live in ONE file that systemd loads every time the service
# starts - so after a reboot, a crash, or a new SSH session nothing has to be set again.
#
# Install (adjust paths/user to your server):
#   sudo useradd --system --no-create-home --shell /usr/sbin/nologin workzen
#   sudo mkdir -p /opt/workzen /etc/workzen
#   sudo cp target/workzen.jar /opt/workzen/ && sudo chown -R workzen:workzen /opt/workzen
#   sudo cp .env.example /etc/workzen/backend.env      # then edit with your REAL values
#   sudo chown root:root /etc/workzen/backend.env && sudo chmod 600 /etc/workzen/backend.env
#   sudo cp deploy/workzen-backend.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now workzen-backend
#
# Change a value later:  edit /etc/workzen/backend.env, then  sudo systemctl restart workzen-backend
# Watch the logs:        sudo journalctl -u workzen-backend -f

[Unit]
Description=WORKZEN backend (Spring Boot)
# Drop mysql.service if the database is on another host (e.g. AWS RDS).
After=network-online.target mysql.service
Wants=network-online.target

[Service]
User=workzen
WorkingDirectory=/opt/workzen
# KEY=value lines, no "export", no quotes needed. Read by systemd as root BEFORE it drops to the
# workzen user, so the file can stay root-only (600) and the app user never needs to read it directly.
EnvironmentFile=/etc/workzen/backend.env
ExecStart=/usr/bin/java -jar /opt/workzen/workzen.jar
Restart=on-failure
RestartSec=5
# Exit code 143 is a normal stop signal for a JVM, not a failure.
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
